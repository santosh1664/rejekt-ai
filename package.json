{
  "name": "rejekt-ai",
  "version": "0.1.0",
  "type": "module",
  "description": "Rejekt.ai: finds jobs on company career pages, matches them to your resume, tailors it honestly, and applies",
  "scripts": {
    "harvest": "node --env-file=.env.local scanner.mjs --harvest",
    "harvest:workday": "node --env-file=.env.local harvester/workday.mjs",
    "harvest:cc": "node harvester/cc-index.mjs",
    "harvest:import": "node --env-file=.env.local harvester/import-slugs.mjs",
    "scan": "node --env-file=.env.local scanner.mjs --scan",
    "freshen": "node --env-file=.env.local scanner.mjs --freshen",
    "stats": "node --env-file=.env.local scanner.mjs --stats",
    "migrate": "node --env-file=.env.local db/migrate.mjs",
    "seed": "node --env-file=.env.local harvester/seed.mjs",
    "prestart": "bash scripts/ensure-ollama.sh",
    "start": "node --env-file=.env.local server.mjs",
    "web": "node --env-file=.env.local server.mjs",
    "api": "node --env-file=.env.local api/server.mjs",
    "test:jobs-api": "node scripts/test-jobs-api.mjs",
    "test:keyword-search": "node scripts/test-keyword-search.mjs",
    "test:dashboard-api": "node scripts/test-dashboard-api.mjs",
    "test:job-sourcing": "node scripts/test-job-sourcing.mjs",
    "test:profiles": "node scripts/test-profiles.mjs",
    "test:auto-apply": "node scripts/test-auto-apply.mjs",
    "autoapply": "node --env-file=.env.local autoapply/run.mjs",
    "smoke:providers": "node scripts/smoke-new-providers.mjs",
    "match": "node --env-file=.env.local matching/matcher.mjs --verbose",
    "recategorize": "node --env-file=.env.local scripts/recategorize.mjs",
    "scan:1": "node --env-file=.env.local scanner.mjs --scan --shard 1/3",
    "scan:2": "node --env-file=.env.local scanner.mjs --scan --shard 2/3",
    "scan:3": "node --env-file=.env.local scanner.mjs --scan --shard 3/3",
    "ml:train": "python3 ml/train.py",
    "ml:server": "python3 ml/classifier-server.py",
    "ml:classify": "node --env-file=.env.local scripts/ml-recategorize.mjs",
    "backfill:canonical": "node --env-file=.env.local scripts/backfill-canonical.mjs",
    "reconcile:raw": "node --env-file=.env.local scripts/reconcile-raw-sources.mjs",
    "backfill:skills": "node --env-file=.env.local scripts/backfill-skills.mjs",
    "db:add-description": "node --env-file=.env.local db/add-description.mjs",
    "watchdog": "node --env-file=.env.local watchdog.mjs",
    "watchdog:verbose": "node --env-file=.env.local watchdog.mjs --verbose",
    "ml:rewriter:export": "node --env-file=.env.local ml/export-rewriter-dataset.mjs",
    "ml:rewriter:train": "bash ml/finetune-rewriter.sh",
    "ml:rewriter:install": "bash ml/install-rewriter.sh",
    "ml:rewriter:eval": "node --env-file=.env.local ml/eval-rewriter.mjs",
    "import:tsenta": "node --env-file=.env.local scripts/import-tsenta.mjs",
    "resume:example": "node --env-file=.env.local scripts/add-resume-example.mjs",
    "test:resume-model": "node scripts/test-resume-model.mjs",
    "ml:rewriter:generate": "node --env-file=.env.local ml/generate-best-of-n.mjs",
    "ml:rewriter:eval-ats": "node --env-file=.env.local ml/eval-ats.mjs",
    "ml:rewriter:idf": "node ml/build-posting-idf.mjs",
    "test:resume-layout": "node scripts/test-resume-layout.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "express": "^5.2.1",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
