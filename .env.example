# Copy to .env.local and fill in your values:  cp .env.example .env.local
# Every npm script reads .env.local. Never commit that file.

# ── Database (any PostgreSQL 14+: local, Neon, RDS …) ────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rejekt
# Only for hosts with a self-signed certificate (for example AWS RDS). Leave it out otherwise.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Web server ───────────────────────────────────────────────────────────────
PORT=3000

# ── Resume rewriting model (runs locally in Ollama by default) ───────────────
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# The fine-tuned model (see "Install the model" in the README). Fallback: qwen2.5:7b-instruct
OLLAMA_MODEL=jd-rewriter-v2
# Hosted alternatives: anthropic | openrouter | huggingface (resume text then leaves your machine)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── Scanner tuning (all optional) ────────────────────────────────────────────
# Override concurrency per ATS
# WORKERS_GREENHOUSE=30
# WORKERS_ASHBY=10
# WORKERS_LEVER=30
# WORKERS_WORKDAY=12
# WORKERS_BAMBOOHR=20
# WORKERS_SMARTRECRUITERS=30
# Skip an ATS for a while (for example after a 429 rate-limit ban): comma list
# SKIP_ATS=workable
# Minimum gap between Workable requests in ms (raise it after a ban)
# WORKABLE_GAP_MS=3000
# How many consecutive missed scans before a job is marked closed
MISSED_SCANS_THRESHOLD=2
# Common Crawl index for the harvester (blank = latest)
COMMON_CRAWL_INDEX=
